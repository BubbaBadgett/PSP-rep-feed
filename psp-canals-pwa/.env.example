# Client-side: prefills the Canals inbox address so nobody has to type it in.
# Reps can still override it locally in Settings if left blank.
VITE_CANALS_INBOX_EMAIL=

# Server-side only (used by api/send.js, a Vercel serverless function) —
# NEVER prefix these with VITE_, they must not ship to the browser bundle.
#
# Sends via Gmail SMTP as this account. GMAIL_USER is the full Gmail
# address; GMAIL_APP_PASSWORD is a 16-character App Password generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account) — NOT the regular account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
